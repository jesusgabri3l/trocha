---
import { ROUTES, formatPrice } from '../../data/routes';
import { SITE } from '../../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [firstRoute] = ROUTES;
const defaultMessage = `Hola TROCHA, quiero reservar la ruta ${firstRoute!.number} ${firstRoute!.name} (${firstRoute!.destination}) para 1 cuatrimoto. Fecha por definir.`;
const defaultWhatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(defaultMessage)}`;
---

<section class="booking" id="reserva" data-booking aria-labelledby="booking-title">
  <div class="booking__body">
    <h2 class="booking__title" id="booking-title">
      <span class="booking__title-line" data-reveal="launch">Escoge</span>
      <span class="booking__title-line" data-reveal="launch" style="--reveal-delay: 120ms">tu ruta</span>
    </h2>

    <form class="booking__form" data-booking-form>
      <fieldset class="booking__routes" data-booking-routes>
        <legend class="sr-only">Ruta</legend>
        {ROUTES.map((route, index) => (
          <label class="booking__route" data-route={route.id}>
            <input class="booking__route-input" type="radio" name="route" value={route.id} checked={index === 0} data-price={route.price} data-label={`${route.number} ${route.name} (${route.destination})`} />
            <img
              class="booking__route-image"
              src={`${base}/img/ruta-${route.id}-800.avif`}
              srcset={`${base}/img/ruta-${route.id}-480.avif 480w, ${base}/img/ruta-${route.id}-800.avif 800w`}
              sizes="(max-width: 767px) 78vw, min(30vw, 400px)"
              alt=""
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
              fetchpriority="high"
            />
            <span class="booking__route-body">
              <span class="booking__route-number">RUTA {route.number}</span>
              <span class="booking__route-name">{route.name}</span>
              <span class="booking__route-meta">{route.destination} · {route.duration}</span>
              <span class="booking__route-price">{formatPrice(route.price)}</span>
            </span>
          </label>
        ))}
      </fieldset>

      <div class="booking__bar" data-reveal="slam">
        <div class="booking__field booking__date" data-datepicker>
          <span class="booking__field-label" id="booking-date-label">Fecha</span>
          <button class="booking__input booking__date-button" type="button" aria-haspopup="dialog" aria-expanded="false" aria-labelledby="booking-date-label booking-date-value" data-date-toggle>
            <span id="booking-date-value" data-date-text>Elige el día</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
          </button>
          <input type="hidden" name="date" data-booking-date />
          <div class="booking__calendar" role="dialog" aria-label="Escoge la fecha" hidden data-calendar>
            <div class="booking__calendar-head">
              <button class="booking__calendar-nav" type="button" data-month="-1" aria-label="Mes anterior">←</button>
              <p class="booking__calendar-month" aria-live="polite" data-month-label></p>
              <button class="booking__calendar-nav" type="button" data-month="1" aria-label="Mes siguiente">→</button>
            </div>
            <div class="booking__calendar-week" aria-hidden="true">
              {['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((day) => <span>{day}</span>)}
            </div>
            <div class="booking__calendar-days" data-days></div>
          </div>
        </div>
        <div class="booking__field">
          <label class="booking__field-label" for="booking-quantity">Cuatrimotos</label>
          <div class="booking__stepper">
            <button class="booking__stepper-button" type="button" data-step="-1" aria-label="Una cuatrimoto menos">−</button>
            <input class="booking__input booking__input--quantity" id="booking-quantity" type="number" name="quantity" min="1" max="8" value="1" inputmode="numeric" data-booking-quantity />
            <button class="booking__stepper-button" type="button" data-step="1" aria-label="Una cuatrimoto más">+</button>
          </div>
        </div>
        <p class="booking__total">
          <span class="booking__field-label">Total</span>
          <output class="booking__total-value" data-booking-total aria-live="polite">{formatPrice(firstRoute!.price)}</output>
          <span class="booking__total-note">Hasta 2 personas por cuatrimoto.</span>
        </p>
        <a class="button button--large booking__submit" href={defaultWhatsappUrl} target="_blank" rel="noopener" data-booking-whatsapp>Reservar por WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span></a>
      </div>
    </form>
  </div>
</section>
